{
 "voice": "am_santa",
 "film": 56.833333333333336,
 "nf": 1705,
 "lines": [
  {
   "id": "home",
   "text": "Home sweet home. Chat... we made it.",
   "start": 1.4,
   "end": 4.551
  },
  {
   "id": "better",
   "text": "Ahh. That's better.",
   "start": 5.6,
   "end": 7.172
  },
  {
   "id": "learned",
   "text": "So. Today we learned...",
   "start": 7.772,
   "end": 9.61
  },
  {
   "id": "cams",
   "text": "Cams turn spinning into lifting.",
   "start": 9.96,
   "end": 12.303
  },
  {
   "id": "rot",
   "text": "Wet wood, plus fungi, makes rot.",
   "start": 12.653,
   "end": 15.062
  },
  {
   "id": "scale",
   "text": "A small drawing can make a big build.",
   "start": 15.412,
   "end": 17.965
  },
  {
   "id": "counter",
   "text": "A counterweight does the heavy lifting.",
   "start": 18.315,
   "end": 20.597
  },
  {
   "id": "circuit",
   "text": "And electricity needs a loop.",
   "start": 20.947,
   "end": 23.133
  },
  {
   "id": "sun",
   "text": "Oh, and... thank you, sun.",
   "start": 23.733,
   "end": 25.962
  },
  {
   "id": "hungry",
   "text": "And the scariest thing in the woods... was just hungry.",
   "start": 26.762,
   "end": 30.459
  },
  {
   "id": "signature",
   "text": "You don't have to know everything. You just have to keep building.",
   "start": 31.359,
   "end": 35.254
  },
  {
   "id": "night",
   "text": "Goodnight, chat.",
   "start": 39.354,
   "end": 40.666
  },
  {
   "id": "hand",
   "text": "...Huh. That's not my handwriting.",
   "start": 44.916,
   "end": 47.088
  },
  {
   "id": "aliens",
   "text": "...Aliens. I KNEW it.",
   "start": 47.788,
   "end": 49.478
  }
 ],
