 "lines": [
  {
   "id": "plan",
   "text": "Chat, Tobias's garden is right where the boar lives. So... we're building him a safe one. Out in the open, by my cabin.",
   "start": 1.7,
   "end": 9.622
  },
  {
   "id": "seed",
   "text": "Then we move his seedlings in. The ones the boar left.",
   "start": 10.022,
   "end": 13.533
  },
  {
   "id": "knees",
   "text": "My knees remember this.",
   "start": 13.533,
   "end": 15.149
  },
  {
   "id": "page",
   "text": "A garden fence. With a lever gate.",
   "start": 16.4,
   "end": 18.858
  },
  {
   "id": "cardio",
   "text": "Post. Rail. Post. Rail. Chat, this is my cardio.",
   "start": 20.658,
   "end": 24.582
  },
  {
   "id": "faster",
   "text": "...Nope. Faster.",
   "start": 30.158,
   "end": 31.457
  },
  {
   "id": "now",
   "text": "Chat... gate. NOW.",
   "start": 38.707,
   "end": 40.444
  }
