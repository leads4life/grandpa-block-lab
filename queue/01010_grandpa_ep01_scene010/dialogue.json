 "lines": [
  {
   "id": "stake",
   "text": "Chat... we're whispering now. Hammer's off. Tonight, the fence works alone.",
   "start": 1.0,
   "end": 6.39
  },
  {
   "id": "stakeout",
   "text": "This is a stakeout.",
   "start": 6.79,
   "end": 8.282
  },
  {
   "id": "hat",
   "text": "I AM wearing a hat.",
   "start": 9.782,
   "end": 11.042
  },
  {
   "id": "awake",
   "text": "Awake! Totally awake. Eyes like an eagle.",
   "start": 19.392,
   "end": 22.698
  },
  {
   "id": "medium",
   "text": "Chat, I'm not scared. I'm... medium-key nervous.",
   "start": 23.698,
   "end": 27.468
  },
  {
   "id": "nocap",
   "text": "NO CAP, CHAT!",
   "start": 29.218,
   "end": 30.415
  },
  {
   "id": "sorry",
   "text": "...Sorry, buddy.",
   "start": 34.615,
   "end": 35.849
  },
  {
   "id": "seedlings",
   "text": "He's not even looking at the seedlings...",
   "start": 38.215,
   "end": 40.477
  },
  {
   "id": "grubs",
   "text": "He doesn't want the garden. He wants grubs.",
   "start": 41.277,
   "end": 44.287
  },
  {
   "id": "neighbour",
   "text": "Chat... I think we just met our neighbour.",
   "start": 46.987,
   "end": 49.335
  },
  {
   "id": "spot",
   "text": "...His own spot.",
   "start": 52.335,
   "end": 53.663
  }
