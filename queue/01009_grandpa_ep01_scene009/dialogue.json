{
 "voice": "am_santa",
 "film": 73.76666666666667,
 "nf": 2213,
 "lines": [
  {
   "id": "bottle",
   "text": "Chat... is that a bottle?",
   "start": 0.8,
   "end": 2.807
  },
  {
   "id": "mail",
   "text": "Chat... somebody's mailing me my own book.",
   "start": 5.8,
   "end": 8.331
  },
  {
   "id": "page",
   "text": "Page thirteen. An electric fence.",
   "start": 8.631,
   "end": 11.441
  },
  {
   "id": "relax",
   "text": "Relax, BoarFan. It doesn't hurt him. It's a tickle... with attitude.",
   "start": 12.341,
   "end": 17.464
  },
  {
   "id": "safety",
   "text": "And kids: never touch one, and never build one without a grown-up who knows how. I'm a grown-up. Allegedly.",
   "start": 17.864,
   "end": 25.161
  },
  {
   "id": "spools",
   "text": "Little spools, so the wire never touches the wood.",
   "start": 27.161,
   "end": 30.584
  },
  {
   "id": "solar",
   "text": "See this panel? It drinks sunshine.",
   "start": 37.011,
   "end": 39.509
  },
  {
   "id": "thanks",
   "text": "Thank you, sun.",
   "start": 39.809,
   "end": 40.797
  },
  {
   "id": "pulse",
   "text": "Then the box sends out a tiny pulse. Tick... tick... tick.",
   "start": 41.197,
   "end": 45.72
  },
  {
   "id": "truth",
   "text": "Moment of truth...",
   "start": 47.12,
   "end": 48.329
  },
  {
   "id": "nothing",
   "text": "...Nothing.",
   "start": 48.929,
   "end": 49.704
  },
  {
   "id": "loop",
   "text": "Ohh. Electricity only travels in a loop. Out the wire, through whoever touches it, into the ground... and back to the box.",
   "start": 50.104,
   "end": 58.072
  },
  {
   "id": "norod",
   "text": "No rod, no loop.",
   "start": 58.372,
   "end": 59.845
  },
  {
   "id": "alive",
   "text": "It's alive. It's ALIVE!",
   "start": 65.245,
   "end": 67.163
  },
  {
   "id": "late",
   "text": "Chat, it's getting late.",
   "start": 68.063,
   "end": 69.568
  },
  {
   "id": "tonight",
   "text": "...Tonight, then.",
   "start": 71.468,
   "end": 72.756
  }
 ],
