   "text": "Apparently I'm a content creator now.",
   "start": 17.891,
   "end": 20.553
  },
  {
   "id": "coffee",
   "text": "Ah, coffee.",
   "start": 20.853,
   "end": 21.921
  },
  {
   "id": "reliable",
   "text": "The one reliable thing in my life.",
