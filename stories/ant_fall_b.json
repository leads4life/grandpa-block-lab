 "lines": [
  {
   "id": "wait",
   "text": "Wait, what? The stone goes thud... and the ant just walks away?",
   "pause": 0.3
  },
  {
   "id": "secret",
   "text": "Here's the secret. When you're tiny, you're so light, the air pushes back almost as hard as gravity pulls.",
   "pause": 0.3
  },
  {
   "id": "walk",
   "text": "So an ant can't fall faster than you walk. That's terminal velocity.",
   "pause": 0.3
  },
  {
   "id": "cat",
   "text": "A cat? About as fast as a car.",
   "pause": 0.3
  },
  {
   "id": "person",
   "text": "A person? Twice that. So we keep our feet on the ground!",
   "pause": 0.3
  },
  {
   "id": "plane",
   "text": "From an airplane? The fall won't hurt an ant. The cold might... brrr.",
   "pause": 0.3
  },
  {
   "id": "loop",
   "text": "And that's exactly why, when you drop an ant...",
   "pause": 0.0
  }
