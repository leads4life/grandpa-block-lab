 "lines": [
  {
   "id": "saw",
   "text": "Chat... you all saw that, right?",
   "start": 2.2,
   "end": 4.041
  },
  {
   "id": "since",
   "text": "I saw it too. I've been watching since 'welcome'.",
   "start": 4.291,
   "end": 7.146,
   "who": "tobias"
  },
  {
   "id": "fourth",
   "text": "...You're my fourth viewer?",
   "start": 7.496,
   "end": 8.976
  },
  {
   "id": "dayone",
   "text": "So you're my... day one!",
   "start": 9.226,
   "end": 10.961
  },
  {
   "id": "isday",
   "text": "Grandpa. It IS day one.",
   "start": 11.111,
   "end": 12.855,
   "who": "tobias"
  },
  {
   "id": "garden",
   "text": "Come see my garden.",
   "start": 13.155,
   "end": 14.413,
   "who": "tobias"
  },
  {
   "id": "knees",
   "text": "Whoa... my knees did not agree to this.",
   "start": 16.385,
   "end": 18.576
  },
  {
   "id": "holes",
   "text": "See those holes? That's rooting. Boars dig with their snouts for roots... and grubs.",
   "start": 18.826,
   "end": 23.693,
   "who": "tobias"
  },
  {
   "id": "grubs",
   "text": "Grubs? ...He can have those.",
   "start": 23.943,
   "end": 26.032
  },
  {
   "id": "best",
   "text": "And that's not even the best thing I fixed.",
   "start": 26.332,
   "end": 28.486,
   "who": "tobias"
  },
  {
   "id": "more",
   "text": "...There's more?",
   "start": 28.836,
   "end": 29.821
  }
