 "lines": [
  {
   "id": "cabbages",
   "text": "My cabbages!",
   "start": 1.55,
   "end": 2.762
  },
  {
   "id": "robbed",
   "text": "Somebody robbed me, chat. And they left... fingerprints.",
   "start": 3.262,
   "end": 7.139
  },
  {
   "id": "on",
   "text": "Is this thing on?",
   "start": 8.089,
   "end": 9.235
  },
  {
   "id": "hot",
   "text": "Hot. Too hot. ...Perfect.",
   "start": 10.935,
   "end": 13.783
  },
  {
   "id": "morning",
   "text": "Good morning, chat. Welcome to Grandpa's Block Lab.",
   "start": 17.683,
   "end": 21.488
  },
  {
   "id": "look",
   "text": "Not the boar, BoarFan. Look. Five little fingers...",
   "start": 22.588,
   "end": 26.548
  },
  {
   "id": "hand",
   "text": "...like a tiny hand. A tiny, hungry hand.",
   "start": 26.748,
   "end": 30.717
  },
  {
   "id": "ratio",
   "text": "A raccoon. My crate got... ratioed.",
   "start": 32.917,
   "end": 36.054
  },
  {
   "id": "wild",
   "text": "Wild animals: we look. We don't touch. And we never feed them.",
   "start": 36.654,
   "end": 40.528
  },
  {
   "id": "ready",
   "text": "Ready, chat? Blocks up!",
   "start": 42.528,
   "end": 44.605
  },
  {
   "id": "stone",
   "text": "Stone lid. Raccoon-proof.",
   "start": 53.105,
   "end": 55.165
  },
  {
   "id": "nothing",
   "text": "Nothing gets past Grandpa Tovi.",
   "start": 58.965,
   "end": 61.339
  }
