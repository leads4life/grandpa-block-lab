 "lines": [
  {
   "id": "fine",
   "text": "...It's fine. It's FINE. Gate.",
   "start": 0.5,
   "end": 2.679
  },
  {
   "id": "lift",
   "text": "A lift gate. Boars push gates open... but they can't lift one.",
   "start": 3.979,
   "end": 8.417
  },
  {
   "id": "vibes",
   "text": "A rock? For... vibes? Nah. Skip.",
   "start": 8.717,
   "end": 11.324
  },
  {
   "id": "giving",
   "text": "This gate is NOT... giving.",
   "start": 14.324,
   "end": 16.459
  },
  {
   "id": "seesaw",
   "text": "Ohh. It's a seesaw.",
   "start": 17.059,
   "end": 18.79
  },
  {
   "id": "cousin",
   "text": "Put your big cousin on the short end, and the little kid can lift the long end.",
   "start": 19.14,
   "end": 23.835
  },
  {
   "id": "draw",
   "text": "Drawbridges work the same way.",
   "start": 24.135,
   "end": 26.207
  },
  {
   "id": "rizz",
   "text": "Now THAT'S got... rizz.",
   "start": 31.707,
   "end": 33.694
  },
  {
   "id": "shuts",
   "text": "And it shuts by itself.",
   "start": 36.194,
   "end": 37.781
  },
  {
   "id": "flip",
   "text": "A boar-proof garden. Tobias is gonna flip.",
   "start": 38.981,
   "end": 42.161
  },
  {
   "id": "scared",
   "text": "Being scared's normal. Building something... helps.",
   "start": 45.261,
   "end": 48.954
  },
  {
   "id": "tobias",
   "text": "Don't tell Tobias I said that.",
   "start": 49.304,
   "end": 51.561
  },
  {
   "id": "bottle",
   "text": "...Is that... page thirteen?",
   "start": 54.361,
   "end": 56.397
  }
